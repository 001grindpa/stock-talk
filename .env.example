# Copy this file to .env and fill in the values you want to use.
# Required for the LangChain agent model layer.
OPENAI_API_KEY=

# Optional legacy Groq settings.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional search provider for market research.
TAVILY_API_KEY=

# Optional DEX quote providers.
ONEINCH_API_KEY=
ZEROX_API_KEY=

# Required by Flask for session signing.
FLASK_SECRET_KEY=change-me

# Optional Base RPC endpoint. Defaults to https://mainnet.base.org if unset.
BASE_RPC_URL=https://mainnet.base.org

# Optional demo/mock mode flag for the app UI.
DEMO_ALLOW_MOCK=0
